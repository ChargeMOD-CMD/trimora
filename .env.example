# ============================================================
# TRIMORA — Neon PostgreSQL Environment Configuration
# ============================================================

# 1. DATABASE CONNECTION (from https://console.neon.tech)
# In your Neon console project dashboard:
# Click "Connection Details" -> select "Pooled connection" or "Direct connection"
# Copy the connection string and paste it below:
DATABASE_URL=postgresql://user:password@ep-your-neon-project.region.aws.neon.tech/neondb?sslmode=require

# 2. SERVER SETTINGS
PORT=5000
NODE_ENV=development

# 3. CLIENT URL (for CORS)
CLIENT_URL=http://localhost:5173

# 4. JWT SECRET
JWT_SECRET=trimora_secret_jwt_neon_2026_key
